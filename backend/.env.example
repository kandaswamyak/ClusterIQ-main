# Environment Configuration Example - Backend
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to GitHub - it contains sensitive credentials

# ===== DATABRICKS CONFIGURATION =====
DATABRICKS_HOST=https://your-workspace-url.azuredatabricks.net
DATABRICKS_TOKEN=your-databricks-token-here

# ===== AZURE OPENAI CONFIGURATION =====
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# ===== SERVER CONFIGURATION =====
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-url.azurewebsites.net

# ===== UPDATE INTERVAL =====
UPDATE_INTERVAL=30

# ===== DELTA TABLE CONFIGURATION =====
DELTA_CLUSTER_EVENTS_TABLE=default.cluster_events
DELTA_CLUSTER_LOGS_TABLE=default.cluster_logs
DELTA_JOB_RUN_LOGS_TABLE=default.job_run_logs

# ===== AZURE SPECIFIC =====
ENVIRONMENT=production
LOG_LEVEL=INFO
